---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/layout/Navigation.astro";
import StatusBar from "../components/layout/StatusBar";
import { SystemLayer } from "../components/interactive/SystemLayer";
import HeroEventLog from "../components/hero/HeroEventLog";
import ProjectForm from "../components/forms/ProjectForm";
import LegalLinks from "../components/legal/LegalLinks.astro";
import { commercialEntries, products } from "../data/site";
import { servicePages } from "../data/servicePages";
import { caseStudies } from "../data/caseStudies";

const title = "IT WHITE - технологический консалтинг и внутренние системы";
const description = "Проектируем, внедряем и сопровождаем внутренние системы, CRM-контроль, AI-инструменты, интеграции и продуктовые решения под реальные процессы бизнеса.";
const telegramUrl = import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/rgvldi";
const coreSolutionAreas = [
  { label: "LOST LEADS CONTROL", slug: "lost-leads", title: "Теряются заявки", text: "Показываем, где обращение выпадает между каналом, CRM, ответственным и следующим действием.", result: "RESULT: источник, SLA, владелец и исключение видны в одном процессе" },
  { label: "AI IN OPERATIONS", slug: "ai-in-operations", title: "AI нужен внутри процесса", text: "Отделяем полезную работу модели от демонстрационного бота и задаём контекст, проверку и границы ответственности.", result: "RESULT: AI готовит или выполняет конкретное действие, а решение остаётся проверяемым" },
  { label: "INTERNAL BUSINESS SYSTEM", slug: "internal-business-system", title: "Таблицы больше не справляются", text: "Собираем роли, данные и обязательные действия в одном рабочем интерфейсе поверх существующих сервисов.", result: "RESULT: команда работает в едином контуре, руководитель видит исключения" }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://itwhite.ru/#organization",
      name: "IT WHITE",
      legalName: "ИП Белый В.М.",
      taxID: "772333809099",
      url: "https://itwhite.ru",
      email: "mailto:info@itwhite.ru",
      employee: [
        { "@id": "https://itwhite.ru/#vladislav-bely" },
        { "@id": "https://itwhite.ru/#denis-korablev" }
      ],
      sameAs: [telegramUrl],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        url: telegramUrl,
        email: "mailto:info@itwhite.ru",
        availableLanguage: ["ru"]
      },
      knowsAbout: [
        "CRM automation",
        "AI automation",
        "Bitrix24",
        "Avito analytics",
        "internal tools",
        "custom product development"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://itwhite.ru/#website",
      name: "IT WHITE",
      url: "https://itwhite.ru",
      publisher: { "@id": "https://itwhite.ru/#organization" },
      inLanguage: "ru-RU"
    },
    {
      "@type": "Person",
      "@id": "https://itwhite.ru/#vladislav-bely",
      name: "Владислав Белый",
      jobTitle: "Product & Engineering Partner",
      image: "https://itwhite.ru/images/team/vladislav-bely-editorial-v1.webp",
      worksFor: { "@id": "https://itwhite.ru/#organization" }
    },
    {
      "@type": "Person",
      "@id": "https://itwhite.ru/#denis-korablev",
      name: "Денис Кораблёв",
      jobTitle: "Business & Delivery Partner",
      image: "https://itwhite.ru/images/team/denis-korablev-editorial-v1.webp",
      worksFor: { "@id": "https://itwhite.ru/#organization" }
    },
    {
      "@type": "Service",
      name: "Технологический консалтинг и разработка внутренних систем",
      provider: { "@id": "https://itwhite.ru/#organization" },
      areaServed: "RU"
    },
    {
      "@type": "Service",
      name: "Разработка продуктов под бизнес-задачу",
      provider: { "@id": "https://itwhite.ru/#organization" },
      areaServed: "RU"
    },
    ...servicePages.map((page) => ({
      "@type": "Service",
      name: page.title,
      description: page.description,
      provider: { "@id": "https://itwhite.ru/#organization" },
      areaServed: "RU",
      url: `https://itwhite.ru/${page.slug}/`,
      serviceType: page.label
    })),
    ...products.map((product) => ({
      "@type": "SoftwareApplication",
      name: product.name,
      applicationCategory: product.type,
      url: product.publicUrl || `https://itwhite.ru/products/#${product.id}`,
      operatingSystem: "Web"
    }))
  ]
};
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="page-shell">
    <Navigation />
    <SystemLayer client:idle />
    <StatusBar client:idle />

    <main id="top" tabindex="-1">
      <section id="intro" class="section hero" aria-labelledby="hero-title" data-status-section>
        <div class="section-inner hero__content">
          <div>
            <p class="section-kicker" data-reveal>Product engineering agency / Business control systems</p>
            <h1 id="hero-title" data-reveal>Бизнес не должен держаться на памяти сотрудников.</h1>
            <p class="hero__lead" data-reveal>Мы находим разрывы между продажами, CRM, данными и действиями команды — и создаём системы, которые возвращают процесс под контроль.</p>
            <div class="hero__thesis" data-reveal>
              <span>POSITION</span>
              <b>Если процесс устроен слабо, говорим об этом прямо и предлагаем новую логику.</b>
            </div>
            <div class="hero__actions">
              <a class="button button--primary" href="/contact/?service=process-review" data-cursor="START">Разобрать проблемный процесс</a>
              <a class="button" href="/work/" data-cursor="OPEN">Посмотреть подтверждённые внедрения</a>
            </div>
            <div class="hero-proof-strip" aria-label="Ключевые факты об IT WHITE" data-reveal>
              <span><b>03</b> внутренних продуктовых контура</span>
              <span><b>50</b> исследовательских карт процессов</span>
              <span><b>02</b> партнёра ведут проект без передачи</span>
            </div>
          </div>
          <HeroEventLog client:idle />
        </div>
        <div class="hero__graph" aria-hidden="true"></div>
      </section>

      <section id="problem" class="section section--problem" data-status-section>
        <div class="section-inner pipeline">
          <div class="problem-copy">
            <p class="section-kicker" data-reveal>Process gaps</p>
            <h2 class="section-title section-title--problem" data-reveal>Деньги теряются не из-за отсутствия AI.</h2>
            <p class="section-copy" data-reveal>Они теряются в разрывах между людьми, сервисами и действиями. IT WHITE находит эти разрывы и закрывает их работающей системой.</p>
            <figure class="editorial-visual editorial-visual--process" data-reveal>
              <img src="/images/editorial/process-break-v1.webp" width="900" height="1125" loading="lazy" decoding="async" alt="Редакционная метафора разрыва бизнес-процесса" />
              <figcaption><span>PROCESS BREAK / DOCUMENTED</span><b>Потеря возникает между действиями, а не внутри отдельного сервиса.</b></figcaption>
            </figure>
          </div>
          <div class="process-chain" aria-label="Разрывы бизнес-процесса">
            {[
              ["Реклама", "connected", "источник фиксируется"],
              ["Обращение", "connected", "заявка получена"],
              ["Менеджер", "manual", "ответ зависит от человека"],
              ["CRM", "partial", "риск не подсвечен"],
              ["Продажа", "unknown", "следующее действие не задано"],
              ["Аналитика", "delayed", "проблему увидели поздно"]
            ].map(([step, status, gap], index) => (
              <div class={`process-step${index === 2 ? " is-break" : ""}`} data-reveal>
                <b>{step}</b>
                <em>{status}</em>
                <small>{gap}</small>
              </div>
            ))}
            <div class="system-layer" data-reveal><span>RESULT:</span> Руководитель узнаёт о проблеме не по факту пожара, а в момент, когда процесс начинает ломаться.</div>
          </div>
        </div>
        <div class="process-break" aria-hidden="true">
          <span>PROCESS BREAK / 03</span>
          <b>MANAGER → CRM</b>
          <b>OWNER: MANUAL</b>
        </div>
      </section>

      <section class="section section--ecosystem" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Control contour</p>
          <h2 class="section-title section-title--ecosystem" data-reveal>IT WHITE создаёт не отдельные боты. Мы строим контур управления.</h2>
          <p class="section-copy" data-reveal>Связываем обращения, коммуникации, CRM, автоматические проверки и аналитику так, чтобы проблема не терялась между системами.</p>
          <p class="section-copy section-copy--sharp" data-reveal>Система сама замечает, где процесс перестал работать, и возвращает проблему ответственному.</p>
          <figure class="editorial-visual editorial-visual--route" data-reveal>
            <img src="/images/editorial/control-route-v1.webp" width="1600" height="800" loading="lazy" decoding="async" alt="Редакционная схема маршрута сигнала через разрыв бизнес-процесса" />
            <figcaption><span>SIGNAL ROUTE / CONTROL LOOP</span><b>Разрыв обнаружен. Контекст проверен. Действие возвращено в процесс.</b></figcaption>
          </figure>
          <div class="ecosystem-map" data-reveal>
            {[
              ["СПРОС", "AVITO / SITE / ADS"],
              ["ОБРАЩЕНИЕ", "FORMS / CALLS / MESSENGERS"],
              ["КОММУНИКАЦИЯ", "TELEGRAM / PHONE / EMAIL"],
              ["CRM", "BITRIX24"],
              ["КОНТРОЛЬ", "AI / SLA"],
              ["РЕШЕНИЕ", "ANALYTICS"]
            ].map(([label, text]) => (
              <div><b>{label}</b><span>{text}</span></div>
            ))}
          </div>
        </div>
      </section>

      <section id="systems" class="section section--systems" data-status-section>
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Product ecosystem</p>
          <h2 class="section-title section-title--systems" data-reveal>Не презентации. Работающие системы.</h2>
          <p class="section-copy" data-reveal>Системы ниже выросли из внутренних операционных задач. Публичный доступ зависит от контура: часть интерфейсов открыта, часть защищена авторизацией или работает без публичной демонстрационной страницы.</p>
          <div class="system-passport" data-reveal>
            <span>PRODUCT SYSTEMS / 03</span>
            <b>03 INTERNAL CONTOURS</b>
            <b>00 CONCEPTS</b>
            <b>04 IN DEVELOPMENT</b>
            <b>DEMO DATA MARKED</b>
          </div>
          <figure class="editorial-visual editorial-visual--control" data-reveal>
            <img src="/images/editorial/control-layer-v1.webp" width="1440" height="960" loading="lazy" decoding="async" alt="Операционная панель контроля с физическими статусными модулями" />
            <figcaption><span>CONTROL LAYER / OPERATING MODE</span><b>Система замечает событие, проверяет контекст и возвращает действие ответственному.</b></figcaption>
          </figure>
          <article class="flagship-control" data-reveal>
            <div>
              <span>FLAGSHIP CONTROL SYSTEM</span>
              <h3>IT WHITE Control</h3>
              <p>Флагманский контур для контроля заявок, SLA, ответственных и возврата проблем в работу. Первый коммерческий сценарий — CRM Lead Control в Bitrix24.</p>
            </div>
            <div class="flagship-control__map" aria-label="Сценарий IT WHITE Control">
              <b>LEAD</b>
              <b>SLA</b>
              <b>AI CONTEXT</b>
              <b>BITRIX24</b>
              <b>MANAGER ACTION</b>
            </div>
            <a href="/it-white-control/">Открыть IT WHITE Control →</a>
          </article>
          <div class="product-scenes">
            {products.map((product) => (
              <article class={`product-scene product-scene--${product.id}`} data-cursor="EXPLORE" data-reveal>
                <div class="product-scene__meta">
                  <span>ENDPOINT: {product.domain}</span>
                  <b>{product.id === "crm" ? "FLAGSHIP / " : ""}STATUS: {product.status.toUpperCase()} / {product.type.toUpperCase()} / ILLUSTRATIVE DATA — NOT CLIENT METRICS</b>
                </div>
                <div class="product-scene__content">
                  <div class="product-scene__copy">
                    <h3>{product.name}</h3>
                    <p>{product.summary}</p>
                    <ul>{product.tasks.slice(0, 4).map((task) => <li>{task}</li>)}</ul>
                  </div>
                  <div class="product-preview" aria-label={`Интерфейс ${product.name}`}>
                    {product.id === "avito" && (
                      <>
                        <div class="product-finding">
                          <span>OBSERVED</span><b>Спрос обнаружен в 17 регионах</b>
                          <span>GAP</span><b>Активное продвижение идёт в 6</b>
                          <span>ACTION</span><b>Создать объявления в 11 регионах</b>
                        </div>
                        <div class="preview-table">
                          {["Новосибирск", "Казань", "Екатеринбург", "Краснодар"].map((city, index) => (
                            <div class={index === 1 ? "is-hot" : ""}>
                              <span>{city}</span><b>{index === 1 ? "HIGH DEMAND" : "DEMAND"}</b><em>{17 - index * 3} signals</em>
                            </div>
                          ))}
                        </div>
                        {product.publicUrl ? <a class="product-link" href={product.publicUrl} target="_blank" rel="noreferrer">Открыть защищённый контур →</a> : <span class="product-link" aria-label="Публичная демонстрация закрыта">PUBLIC DEMO: CLOSED</span>}
                      </>
                    )}
                    {product.id === "telegram" && (
                      <>
                        <div class="product-finding product-finding--compact">
                          <span>04 ACCOUNTS</span><b>01 CONTROL PANEL</b>
                          <span>00 LOST DIALOGUES</span><b>единая история действий</b>
                        </div>
                        <div class="telegram-flow">
                          {["ACCOUNT 01", "ACCOUNT 02", "ACCOUNT 03", "ACCOUNT 04"].map((account) => <span>{account}</span>)}
                          <b>UNIFIED INBOX</b>
                        </div>
                        <div class="feature-line"><span>распределение диалогов</span><span>контроль ответов</span><span>AI-классификация</span></div>
                        {product.publicUrl ? <a class="product-link" href={product.publicUrl} target="_blank" rel="noreferrer">Открыть продукт →</a> : <span class="product-link">PUBLIC DEMO: CLOSED</span>}
                      </>
                    )}
                    {product.id === "crm" && (
                      <>
                        <div class="lead-flow">
                          {["01 Лид поступил", "02 Ответ не зафиксирован", "03 GigaChat анализирует контекст", "04 Риск пропуска подтверждён", "05 Уведомление отправлено"].map((step) => <span>{step}</span>)}
                        </div>
                        <div class="bot-alert">
                          <span>⚠ LEAD CONTROL</span>
                          <b>Источник: Авито</b>
                          <b>Время без реакции: 27 минут</b>
                          <b>Ответственный: не назначен</b>
                          <em>Статус: требуется проверка</em>
                        </div>
                        {product.publicUrl ? <a class="product-link" href={product.publicUrl} target="_blank" rel="noreferrer">Открыть защищённый контур →</a> : <span class="product-link">PUBLIC DEMO: CLOSED</span>}
                      </>
                    )}
                  </div>
                </div>
                <div class="control-strip">
                  <span>OWNER: SYSTEM</span>
                  <span>ACTION: CONTROL</span>
                  <span>STATUS: CONNECTED</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--solutions" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <p class="section-kicker" data-reveal>What we build</p>
          <h2 class="section-title section-title--solutions" data-reveal>Три направления, с которых обычно начинается работа.</h2>
          <p class="section-copy" data-reveal>Главная задача не в том, чтобы “сделать IT”. Мы закрепляем правильную логику работы в CRM, внутреннем сервисе или продуктовой системе.</p>
          <div class="solution-grid">
            {coreSolutionAreas.map((area) => (
              <article class="solution-card" data-reveal>
                <span>{area.label}</span>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
                <small>{area.result}</small>
                <a href={`/${area.slug}/`}>Открыть направление →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      

      <section class="section section--proof" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Proof layer</p>
          <h2 class="section-title section-title--proof" data-reveal>IT WHITE вырос из реальных операционных ограничений, а не из презентации про AI.</h2>
          <div class="proof-grid">
            <article data-reveal><span>VERIFIED WORK</span><b>INTERNAL PRODUCTION</b><p>CRM Lead Control работает в закрытом операционном контуре; границы и роль человека описаны в разделе внедрений</p></article>
            <article data-reveal><span>PRODUCT CONTOURS</span><b>03</b><p>CRM Lead Control, Telegram Multiaccount и Avito Geo Demand с честной маркировкой публичного доступа</p></article>
            <article data-reveal><span>CONTROL OBJECTS</span><b>CRM / ADS / AI / DATA</b><p>соединяем источники спроса, коммуникации, CRM и аналитику</p></article>
            <article data-reveal><span>FIRST STAGE OUTPUT</span><b>PROCESS MAP</b><p>карта процесса, точки потерь, архитектура решения, предварительная экономика</p></article>
          </div>
        </div>
      </section>

      <section class="section section--pricing" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Formats / budget</p>
          <h2 class="section-title section-title--pricing" data-reveal>Три входа в работу: Diagnose, Launch, Operate.</h2>
          <p class="section-copy" data-reveal>Первый разговор помогает понять, есть ли задача для IT WHITE. Дальше работа не распадается на десятки услуг: мы либо диагностируем процесс, либо запускаем первый контур, либо сопровождаем систему после внедрения.</p>
          <div class="entry-grid" data-reveal>
            <article>
              <span>PRIMARY REVIEW / INTRO</span>
              <b>Контекст и следующий шаг</b>
              <p>Проверяем, относится ли задача к компетенции IT WHITE. Полная карта процесса выполняется только в отдельной диагностике.</p>
            </article>
            <article>
              <span>PAID DIAGNOSTIC</span>
              <b>1–2 недели</b>
              <p>Интервью, карта процесса, точки потерь, риски, архитектурные варианты и предварительная экономика.</p>
            </article>
          </div>
          <div class="pricing-grid pricing-grid--commercial" data-reveal>
            {commercialEntries.map(([title, price, text]) => (
              <article>
                <span>{title}</span>
                <b>{price}</b>
                <p>{text}</p>
              </article>
            ))}
          </div>
          <div class="pricing-note" data-reveal>
            <span>RULE</span>
            <b>Сначала карта процесса и границы решения. Только потом точная оценка разработки.</b>
            <a href="/formats/">Подробные вилки и технические форматы →</a>
          </div>
        </div>
      </section>

      <section id="case" class="section section--case" data-status-section>
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Verified internal work</p>
          <h2 class="section-title section-title--case" data-reveal>Как контроль пропущенных лидов превратился в продукт.</h2>
          <div class="case-intro" data-reveal>
            <p>В CRM есть лид. Менеджер не ответил. Формально система работает — фактически клиент уже потерян.</p>
            <p>Мы добавили второй уровень контроля: система анализирует состояние обращения и возвращает пропущенный лид в рабочий чат.</p>
          </div>
          <div class="case-context" data-reveal aria-label="Контекст внедрения CRM Lead Control">
            <article><span>ENVIRONMENT</span><b>Bitrix24 / Avito / Telegram</b></article>
            <article><span>IMPLEMENTATION</span><b>3 недели</b></article>
            <article><span>STATUS</span><b>Internal production</b></article>
            <article><span>CONTROL</span><b>лиды без ответственного и реакции</b></article>
            <article><span>HUMAN DECISION</span><b>критические события проверяет руководитель</b></article>
          </div>
          <div class="case-system" data-cursor="VIEW CASE">
            <article class="case-lane">
              <h3>До</h3>
              {["Лид поступил", "Ответственный не назначен", "Лид не замечен"].map((item, index) => (
                <span class={index === 1 ? "is-break" : ""}>{item}</span>
              ))}
            </article>
            <article class="bot-message">
              <span>SYSTEM</span>
              <b>TIMER: 00:27:14</b>
              <b>MESSAGE STATUS: NO RESPONSE</b>
              <b>AI ANALYSIS: ATTENTION REQUIRED</b>
              <p>CONTROL TYPE: AUTOMATIC<br />MANUAL CHECK: REQUIRED</p>
            </article>
            <article class="case-lane">
              <h3>После</h3>
