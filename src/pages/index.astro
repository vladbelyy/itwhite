---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/layout/Navigation.astro";
import ProjectForm from "../components/forms/ProjectForm";
import LegalLinks from "../components/legal/LegalLinks.astro";
import { commercialEntries, products } from "../data/site";
import { servicePages } from "../data/servicePages";
import { caseStudies } from "../data/caseStudies";
import { redirectedServiceSlugs } from "../lib/sitemap-governance";

const title = "IT WHITE - технологический консалтинг и внутренние системы";
const description = "Проектируем, внедряем и сопровождаем внутренние системы, CRM-контроль, AI-инструменты, интеграции и продуктовые решения под реальные процессы бизнеса.";
const telegramUrl = import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/rgvldi";
const homeDirections = [
  { code: "01", slug: "process-automation", title: "Автоматизация процессов", text: "Находим ручные разрывы и собираем управляемый маршрут действий." },
  { code: "02", slug: "crm-automation", title: "CRM и Bitrix24", text: "Настраиваем контроль заявок, SLA, ответственных и интеграций." },
  { code: "03", slug: "internal-tools", title: "Внутренние системы", text: "Создаём рабочие кабинеты и панели поверх существующих данных." },
  { code: "04", slug: "ai-automation", title: "Контролируемый AI", text: "Встраиваем модели туда, где результат можно проверить и остановить." },
  { code: "05", slug: "technical-consulting", title: "Технический консалтинг", text: "Проверяем архитектуру, код, инфраструктуру и риски до изменений." },
  { code: "06", slug: "custom-product-development", title: "Инструменты под процессы", text: "Проектируем специализированные решения вокруг процесса, ролей и критериев приёмки." }
];
const secondaryProducts = products.filter((product) => product.id !== "crm");
const stageTitles: Record<string, string> = {
  Diagnose: "Диагностика",
  Launch: "Внедрение",
  Operate: "Развитие"
};
const canonicalServicePages = servicePages.filter((page) => !redirectedServiceSlugs.has(page.slug));
const homeUrl = "https://itwhite.ru/";
const websiteId = `${homeUrl}#website`;
const webpageId = `${homeUrl}#webpage`;
const organizationId = `${homeUrl}#organization`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "IT WHITE",
      legalName: "ИП Белый В.М.",
      taxID: "772333809099",
      url: homeUrl,
      email: "mailto:info@itwhite.ru",
      employee: [
        { "@id": "https://itwhite.ru/#vladislav-bely" },
        { "@id": "https://itwhite.ru/#denis-korablev" }
      ],
      sameAs: [telegramUrl],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        url: telegramUrl,
        email: "mailto:info@itwhite.ru",
        availableLanguage: ["ru"]
      },
      knowsAbout: [
        "CRM automation",
        "AI automation",
        "Bitrix24",
        "Avito analytics",
        "business process automation",
        "technology consulting",
        "internal tools",
        "custom product development"
      ]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "IT WHITE",
      url: homeUrl,
      publisher: { "@id": organizationId },
      inLanguage: "ru-RU"
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: homeUrl,
      name: title,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
      mainEntity: { "@id": `${homeUrl}#technical-consulting-service` },
      inLanguage: "ru-RU"
    },
    {
      "@type": "Person",
      "@id": "https://itwhite.ru/#vladislav-bely",
      name: "Владислав Белый",
      jobTitle: "Product & Engineering Partner",
      image: "https://itwhite.ru/images/team/vladislav-bely-editorial-v1.webp",
      worksFor: { "@id": organizationId }
    },
    {
      "@type": "Person",
      "@id": "https://itwhite.ru/#denis-korablev",
      name: "Денис Кораблёв",
      jobTitle: "Business & Delivery Partner",
      image: "https://itwhite.ru/images/team/denis-korablev-editorial-v1.webp",
      worksFor: { "@id": organizationId }
    },
    {
      "@type": "Service",
      "@id": `${homeUrl}#technical-consulting-service`,
      name: "Технологический консалтинг и разработка внутренних систем",
      description,
      provider: { "@id": organizationId },
      areaServed: "RU",
      url: homeUrl,
      mainEntityOfPage: { "@id": webpageId }
    },
    ...canonicalServicePages.map((page) => {
      const pageUrl = `https://itwhite.ru/${page.slug}/`;
      return {
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        name: page.title,
        description: page.description,
        provider: { "@id": organizationId },
        areaServed: "RU",
        url: pageUrl,
        mainEntityOfPage: pageUrl,
        serviceType: page.label
      };
    }),
    ...products.map((product) => ({
      "@type": "SoftwareApplication",
      name: product.name,
      applicationCategory: product.type,
      url: product.publicUrl || `https://itwhite.ru/products/#${product.id}`,
      operatingSystem: "Web"
    }))
  ]
};
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="page-shell">
    <Navigation />

    <main id="top" tabindex="-1">
      <section id="intro" class="section hero" aria-labelledby="hero-title" data-status-section>
        <div class="section-inner hero__content">
          <div class="hero__copy">
            <p class="section-kicker">Системы управления для бизнеса</p>
            <h1 id="hero-title">Бизнес не должен держаться на памяти сотрудников.</h1>
            <p class="hero__lead">Находим ручные процессы, потерянные данные и точки зависимости от сотрудников — затем собираем из них работающую цифровую систему.</p>
            <div class="hero__actions">
              <a class="button button--primary" href="/contact/?service=process-review" data-cursor="START">Разобрать процесс</a>
              <a class="hero__work-link" href="/work/" data-cursor="OPEN">Посмотреть рабочие контуры <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="hero-route" aria-label="Как система возвращает процесс под контроль">
            <div class="hero-route__head"><span>CONTROL ROUTE / 01</span><b>Событие не потеряно</b></div>
            <ol>
              <li><span>01</span><div><b>Сигнал</b><small>обращение или отклонение</small></div></li>
              <li><span>02</span><div><b>Проверка</b><small>контекст и правила</small></div></li>
              <li><span>03</span><div><b>Ответственный</b><small>роль и срок реакции</small></div></li>
              <li><span>04</span><div><b>Действие</b><small>возвращено в процесс</small></div></li>
            </ol>
            <p><i aria-hidden="true"></i> Контур работает поверх CRM, сервисов и данных компании.</p>
          </aside>
        </div>
      </section>

      <section class="section section--directions" aria-labelledby="directions-title" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <div class="directions-head">
            <p class="section-kicker">Направления / 06</p>
            <h2 id="directions-title">Что можно вернуть под контроль.</h2>
            <p>Начинаем не с технологии, а с места, где процесс теряет деньги, время или управляемость.</p>
          </div>
          <div class="direction-list">
            {homeDirections.map((direction) => (
              <a href={`/${direction.slug}/`}>
                <span>{direction.code}</span>
                <div><h3>{direction.title}</h3><p>{direction.text}</p></div>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="problem" class="section section--problem" data-status-section>
        <div class="section-inner pipeline">
          <div class="problem-copy">
            <p class="section-kicker" data-reveal>Process gaps</p>
            <h2 class="section-title section-title--problem" data-reveal>Деньги теряются не из-за отсутствия AI.</h2>
            <p class="section-copy" data-reveal>Они теряются в разрывах между людьми, сервисами и действиями. IT WHITE находит эти разрывы и закрывает их работающей системой.</p>
            <figure class="editorial-visual editorial-visual--process" data-reveal>
              <img src="/images/editorial/process-break-v1.webp" width="900" height="1125" loading="lazy" decoding="async" alt="Редакционная метафора разрыва бизнес-процесса" />
              <figcaption><span>PROCESS BREAK / DOCUMENTED</span><b>Потеря возникает между действиями, а не внутри отдельного сервиса.</b></figcaption>
            </figure>
          </div>
          <div class="process-chain" aria-label="Разрывы бизнес-процесса">
            {[
              ["Реклама", "connected", "источник фиксируется"],
              ["Обращение", "connected", "заявка получена"],
              ["Менеджер", "manual", "ответ зависит от человека"],
              ["CRM", "partial", "риск не подсвечен"],
              ["Продажа", "unknown", "следующее действие не задано"],
              ["Аналитика", "delayed", "проблему увидели поздно"]
            ].map(([step, status, gap], index) => (
              <div class={`process-step${index === 2 ? " is-break" : ""}`} data-reveal>
                <b>{step}</b>
                <em>{status}</em>
                <small>{gap}</small>
              </div>
            ))}
            <div class="system-layer" data-reveal><span>RESULT:</span> Руководитель узнаёт о проблеме не по факту пожара, а в момент, когда процесс начинает ломаться.</div>
          </div>
        </div>
        <div class="process-break" aria-hidden="true">
          <span>PROCESS BREAK / 03</span>
          <b>MANAGER → CRM</b>
          <b>OWNER: MANUAL</b>
        </div>
      </section>

      <section class="section section--ecosystem" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <p class="section-kicker" data-reveal>Control contour</p>
          <h2 class="section-title section-title--ecosystem" data-reveal>Не отдельные боты и интеграции. Собираем единый контур управления бизнесом.</h2>
          <p class="section-copy" data-reveal>Связываем обращения, коммуникации, CRM, автоматические проверки и аналитику так, чтобы проблема не терялась между системами.</p>
          <p class="section-copy section-copy--sharp" data-reveal>Система сама замечает, где процесс перестал работать, и возвращает проблему ответственному.</p>
          <figure class="editorial-visual editorial-visual--route" data-reveal>
            <img src="/images/editorial/control-route-v1.webp" width="1600" height="800" loading="lazy" decoding="async" alt="Редакционная схема маршрута сигнала через разрыв бизнес-процесса" />
            <figcaption><span>SIGNAL ROUTE / CONTROL LOOP</span><b>Разрыв обнаружен. Контекст проверен. Действие возвращено в процесс.</b></figcaption>
          </figure>
          <div class="ecosystem-map" data-reveal>
            {[
              ["СПРОС", "AVITO / SITE / ADS"],
              ["ОБРАЩЕНИЕ", "FORMS / CALLS / MESSENGERS"],
              ["КОММУНИКАЦИЯ", "TELEGRAM / PHONE / EMAIL"],
              ["CRM", "BITRIX24"],
              ["КОНТРОЛЬ", "AI / SLA"],
              ["РЕШЕНИЕ", "ANALYTICS"]
            ].map(([label, text]) => (
              <div><b>{label}</b><span>{text}</span></div>
            ))}
          </div>
        </div>
      </section>

      <section id="case" class="section section--case section--case-priority" data-status-section>
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title section-title--case">Один рабочий кейс вместо обещаний.</h2>
            <p>CRM Lead Control — внутренний production-контур, который проверяет лиды без ответственного или реакции и возвращает сигнал руководителю.</p>
          </header>
          <div class="case-brief">
            <div class="case-brief__story" data-reveal>
              <article><span>Было</span><b>Лид уже есть в CRM, но ответственный или реакция не зафиксированы.</b></article>
              <article><span>Сделали</span><b>Подключили проверку ответственного, реакции и контекста обращения.</b></article>
              <article><span>Стало</span><b>Руководитель получает сигнал в рабочем чате и сам принимает критическое решение.</b></article>
            </div>
            <article class="case-signal" data-reveal>
              <span>Иллюстративный сигнал / не клиентская метрика</span>
              <h3>Лид без реакции</h3>
              <p><b>Источник</b><span>Bitrix24 / Avito</span></p>
              <p><b>Риск</b><span>Ответственный не назначен</span></p>
              <p><b>Действие</b><span>Проверка руководителя</span></p>
            </article>
          </div>
          <div class="case-facts" data-reveal>
            <span><b>3 недели</b> внедрение</span>
            <span><b>Internal production</b> статус</span>
            <span><b>Human decision</b> критические действия</span>
          </div>
          <div class="section-actions" data-reveal>
            <a class="button button--primary" href="/work/">Смотреть внедрения</a>
            <a class="text-link" href="/it-white-control/">Как устроен контроль <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section id="systems" class="section section--systems" data-status-section>
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title section-title--systems">Часть решений мы уже превратили в продукты.</h2>
            <p>Показываем статус и границы доступа прямо. Подробные интерфейсы вынесены в продуктовый раздел, а здесь — только назначение и рабочая логика.</p>
          </header>

          <article class="flagship-brief" data-reveal>
            <div class="flagship-brief__copy">
              <span>Флагманский контур / Live private</span>
              <h3>IT WHITE Control</h3>
              <p>Контроль заявок, SLA и ответственных. Первый рабочий сценарий — CRM Lead Control в Bitrix24.</p>
              <a href="/it-white-control/">Открыть устройство системы <span aria-hidden="true">→</span></a>
            </div>
            <ol class="flagship-route" aria-label="Логика IT WHITE Control">
              <li><span>Событие</span><b>Лид поступил</b></li>
              <li><span>Проверка</span><b>Ответ не зафиксирован</b></li>
              <li><span>Контекст</span><b>Риск подтверждён</b></li>
              <li><span>Действие</span><b>Лид возвращён в работу</b></li>
            </ol>
          </article>

          <div class="product-register" aria-label="Реестр внутренних систем IT WHITE">
            {secondaryProducts.map((product, index) => (
              <article>
                <header>
                  <span>{String(index + 2).padStart(2, "0")} / {product.type}</span>
                  <em>{product.status}</em>
                </header>
                <h3>{product.name}</h3>
                <p>{product.summary}</p>
                <ul>{product.tasks.slice(0, 2).map((task) => <li>{task}</li>)}</ul>
                {product.publicUrl
                  ? <a href={product.publicUrl} target="_blank" rel="noreferrer">Открыть рабочий контур <span aria-hidden="true">↗</span></a>
                  : <a href="/products/">Посмотреть описание <span aria-hidden="true">→</span></a>}
              </article>
            ))}
          </div>

          <div class="systems-proofline" aria-label="Границы доказательств">
            <span><b>03</b> внутренних контура</span>
            <span><b>Live / private</b> статус указан для каждого</span>
            <span><b>Demo data</b> не выдаются за клиентские метрики</span>
          </div>
        </div>
      </section>

      <section class="section section--pricing" data-status-section data-nav-current="systems">
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title section-title--pricing">Три этапа работы. Понятные границы бюджета.</h2>
            <p>Первый разговор определяет контекст и следующий шаг. Полная карта процесса появляется в платной диагностике — до точной оценки разработки.</p>
          </header>
          <div class="work-stage-list">
            {commercialEntries.map(([title, price, text], index) => (
              <article>
                <header><span>{String(index + 1).padStart(2, "0")}</span><h3>{stageTitles[title]}</h3></header>
                <b>{price}</b>
                <p>{text}</p>
              </article>
            ))}
          </div>
          <div class="pricing-commitment" data-reveal>
            <p><b>Правило оценки.</b> Сначала фиксируем процесс, ограничения и критерии результата. Только после этого считаем внедрение.</p>
            <a href="/formats/">Все форматы и диапазоны <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="section section--case-library" data-status-section data-nav-current="case">
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title">Не всё нужно автоматизировать. Мы знаем, что имеет смысл.</h2>
            <p>50 редакционных карт процессов, не клиентские кейсы. В каждой: архитектура, KPI, роль человека и честные границы автоматизации.</p>
          </header>
          <div class="case-index-list">
            {caseStudies.slice(0, 3).map((study, index) => (
              <a href={`/cases/${study.slug}/`} data-reveal>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div><small>{study.sector} / {study.area}</small><h3>{study.title}</h3></div>
                <p>{study.problem}</p>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
          <div class="section-actions"><a class="button" href="/cases/">Смотреть все 50 сценариев</a></div>
        </div>
      </section>

      <section id="method" class="section dark-section method-section" data-status-section>
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title section-title--method">Разобраться. Запустить. Сопровождать.</h2>
            <p>Путь клиента — три понятных этапа. На каждом есть самостоятельный результат и точка решения о продолжении.</p>
          </header>
          <div class="method-path">
            <article data-reveal><span>01 / Diagnose</span><h3>Находим потерю</h3><p>Интервью, карта процесса, роли, данные, ручные обходы, риски и предварительная экономика.</p><b>Карта / риски / экономика</b></article>
            <article data-reveal><span>02 / Launch</span><h3>Запускаем первый контур</h3><p>Проектируем интерфейс, интеграции и контрольные события. Запускаем сценарий в реальной среде.</p><b>Контур / интеграции / критерии</b></article>
            <article data-reveal><span>03 / Operate</span><h3>Доводим до привычки</h3><p>Следим за SLA, качеством данных и тем, как команда использует новый процесс.</p><b>SLA / качество / развитие</b></article>
          </div>
        </div>
      </section>

      <section id="team" class="section section--team" data-status-section>
        <div class="section-inner">
          <header class="mobile-section-head" data-reveal>
            <h2 class="section-title section-title--team">Проект ведут партнёры, а не аккаунт-менеджеры.</h2>
            <p>Архитектуру, внедрение и работу с командой клиента не передаём по цепочке: бизнес-логика и техническое исполнение остаются в одном контуре.</p>
          </header>
          <div class="partner-list" aria-label="Партнёры IT WHITE">
            <article data-reveal>
              <img class="partner-portrait" src="/images/team/vladislav-bely-editorial-v1.webp" width="960" height="1200" loading="lazy" decoding="async" alt="Владислав Белый, Product & Engineering Partner IT WHITE" />
              <div><span>Product & Engineering Partner</span><h3>Владислав Белый</h3>
              <p>Отвечает за то, чтобы бизнес-логика стала работающей системой: от архитектуры и модели данных до интерфейсов, интеграций, AI и запуска.</p>
              <small>Product strategy / Architecture / AI / Integrations</small></div>
            </article>
            <article data-reveal>
              <img class="partner-portrait" src="/images/team/denis-korablev-editorial-v1.webp" width="960" height="1200" loading="lazy" decoding="async" alt="Денис Кораблёв, Business & Delivery Partner IT WHITE" />
              <div><span>Business & Delivery Partner</span><h3>Денис Кораблёв</h3>
              <p>Отвечает за то, чтобы решение было нужно бизнесу, имело понятную экономику и было внедрено в ежедневную работу команды.</p>
              <small>Discovery / Strategy / Delivery / Adoption</small></div>
            </article>
          </div>
          <div class="ownership-brief" data-reveal><span>One project / two owners</span><b>Архитектура, экономика, внедрение и принятие решения контролируются вместе.</b></div>
