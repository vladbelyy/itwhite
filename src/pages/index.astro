    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

      if (!prefersReducedMotion.matches && revealItems.length) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const item = entry.target as HTMLElement;
            item.classList.add("is-visible");
            revealObserver.unobserve(item);
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });

        revealItems.forEach((item) => {
          const section = item.closest("section");
          const sectionItems = section ? Array.from(section.querySelectorAll<HTMLElement>("[data-reveal]")) : [item];
          const localIndex = Math.max(0, sectionItems.indexOf(item));
          item.style.setProperty("--reveal-delay", `${Math.min(localIndex, 3) * 45}ms`);

          if (item.getBoundingClientRect().top <= window.innerHeight * 0.92) {
            item.classList.add("is-visible");
            return;
          }

          item.classList.add("is-reveal-pending");
          revealObserver.observe(item);
        });
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }

      const mobileStickyCta = document.querySelector<HTMLElement>("[data-mobile-sticky-cta]");
      const contactSection = document.querySelector<HTMLElement>("#contact");
      const mobileViewport = window.matchMedia("(max-width: 900px)");

      if (mobileStickyCta && contactSection) {
        let contactStart = 0;
        const measureContactStart = () => {
          contactStart = contactSection.getBoundingClientRect().top + window.scrollY;
        };
        const syncMobileStickyCta = () => {
          const hasScrolled = window.scrollY > Math.max(180, window.innerHeight * 0.2);
          const isBeforeContact = window.scrollY + window.innerHeight * 0.82 < contactStart;
          mobileStickyCta.classList.toggle("is-visible", mobileViewport.matches && hasScrolled && isBeforeContact);
        };

        const handleResize = () => {
          measureContactStart();
          syncMobileStickyCta();
        };

        measureContactStart();
        window.addEventListener("scroll", syncMobileStickyCta, { passive: true });
        window.addEventListener("resize", handleResize, { passive: true });
        syncMobileStickyCta();
      }
    </script>
