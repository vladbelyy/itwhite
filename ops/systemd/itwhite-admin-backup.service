[Unit]
Description=IT WHITE admin database and media backup
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=itwhite-admin
ExecStart=/usr/local/sbin/itwhite-admin-backup
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/itwhite-admin.env /var/lib/itwhite-admin
ReadWritePaths=/var/backups/itwhite-admin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
