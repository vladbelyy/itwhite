# Required. Use a dedicated PostgreSQL role and database.
DATABASE_URL=postgresql://itwhite_admin:CHANGE_ME@127.0.0.1:5432/itwhite_admin
# Required. Generate at least 32 random bytes; never commit the real value.
PAYLOAD_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Production origin. Payload CORS and CSRF are restricted to this exact origin.
ADMIN_ORIGIN=https://admin.itwhite.ru
NEXT_PUBLIC_SERVER_URL=https://admin.itwhite.ru

# Keep the CMS inside the server connection budget.
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Persistent path outside an atomic application release.
MEDIA_DIR=/var/lib/itwhite-admin/media

# Used only by `pnpm seed:owner`; no defaults exist in code.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_UNIQUE_PASSWORD
